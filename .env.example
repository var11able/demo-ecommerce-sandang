# Copy to .env and fill in. Never commit .env.

# In production use the database provider's pooled connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sandang
# The app's own address. State-changing requests must carry this as their Origin.
APP_ORIGIN=http://localhost:3000
# Shared secret Vercel sends when it calls the daily job
CRON_SECRET=change-me
# Public demo rules: seeded accounts, limited demo Admin, daily reset
DEMO_MODE=false
# The first real Admin, created by the seed script. Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Vercel Blob (product photos). Filled in by `vercel env pull` once the store is connected.
BLOB_READ_WRITE_TOKEN=

# Midtrans: SANDBOX keys only (Dashboard > Settings > Access Keys)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Sent to the browser. Never put a secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
